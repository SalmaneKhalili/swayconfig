# ---------------------------------------------------------------------------
# Application data, not configuration.
# These directories hold app state, caches, sessions and credentials. They are
# managed by the applications themselves and must never be committed.
# ---------------------------------------------------------------------------
discord/
vesktop/
mozilla/
JetBrains/
obsidian/
superProductivity/
ai.opencode.desktop/
obs-studio/
go/
github-copilot/
yay/
procps/
dconf/
uv/
yad/
evolution/
opencode/

# ---------------------------------------------------------------------------
# Compiled artifacts. Rebuilt from the checked-in Go source, and not portable
# across machines or architectures.
#   cd waybar/scripts/weather-stats && go build -o weather-stats
# ---------------------------------------------------------------------------
waybar/scripts/weather-stats/weather-stats

# ---------------------------------------------------------------------------
# Generated by fish. Recreated on startup; encodes absolute paths and
# machine-specific state.
# ---------------------------------------------------------------------------
fish/fish_variables

# ---------------------------------------------------------------------------
# Credentials. gh/hosts.yml contains GitHub OAuth tokens.
# ---------------------------------------------------------------------------
gh/hosts.yml

# ---------------------------------------------------------------------------
# Managed as its own repository (git init inside the directory). Ignored here
# so this repo does not track it as a gitlink.
# ---------------------------------------------------------------------------
/nvim/

# ---------------------------------------------------------------------------
# Runtime state, caches and generated files.
# ---------------------------------------------------------------------------
pulse/cookie
autostart/mimeinfo.cache
welcome_news_latest_date_file

# systemd enablement symlinks. These record that a unit is enabled on this
# machine; enable it with `systemctl --user enable` instead.
systemd/user/*.wants/
*.log
*.log.*
*.db
*.db-wal
*.db-shm
*.swp
*~
.DS_Store
.idea/
.vscode/
